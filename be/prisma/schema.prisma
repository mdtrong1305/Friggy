generator client {
  provider     = "prisma-client"
  output       = "../src/modules-system/prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Role {
  id          Int       @id @default(autoincrement())
  name        RoleName  @unique
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  users       User[]

  @@map("roles")
}

model User {
  id                    String              @id @default(uuid()) @db.Char(36)
  email                 String?             @unique @db.VarChar(255)
  passwordHash          String?             @db.VarChar(255)
  googleId              String?             @unique @db.VarChar(255)
  googleEmail           String?             @db.VarChar(255)
  authProvider          AuthProvider
  status                UserStatus          @default(pending)
  roleId                Int
  lastLoginAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  isOnboardingCompleted Boolean             @default(false)
  name                  String?             @db.VarChar(100)
  adminLogs             AdminActivityLog[]
  activatedConfigs      AiProviderConfig[]  @relation("ConfigActivatedBy")
  activatedPrompts      AiSystemPrompt[]    @relation("PromptActivatedBy")
  aiUsageLogs           AiUsageLog[]
  chatSessions          ChatSession[]
  fridgeItems           FridgeItem[]
  scanLogs              IngredientScanLog[]
  notifications         Notification[]
  familyOwned          FamilyGroup?   @relation("FamilyOwner")
  familyMemberships    FamilyMember[]  @relation("FamilyMember")
  authoredRecipes       Recipe[]
  refreshTokens         RefreshToken[]
  shoppingLists         ShoppingList[]
  allergies             UserAllergy[]
  preferences           UserPreference?
  profile               UserProfile?
  savedRecipes          UserSavedRecipe[]
  subscription          UserSubscription?
  paymentTransactions   PaymentTransaction[]
  role                  Role                @relation(fields: [roleId], references: [id])
  weeklyPlans           WeeklyPlan[]
  devices               UserDevice[]

  @@index([roleId], map: "users_roleId_fkey")
  @@map("users")
}

model EmailOtp {
  id        String          @id @default(uuid()) @db.Char(36)
  email     String          @db.VarChar(255)
  otpHash   String          @db.VarChar(255)
  purpose   EmailOtpPurpose
  attempts  Int             @default(0) @db.TinyInt
  expiresAt DateTime
  createdAt DateTime        @default(now())

  @@index([email, purpose, expiresAt])
  @@map("email_otps")
}

model UserProfile {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @unique @db.Char(36)
  displayName String    @db.VarChar(100)
  avatarPath  String?   @db.VarChar(512)
  dateOfBirth DateTime? @db.Date
  gender      Gender?
  bio         String?   @db.Text
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model UserPreference {
  id                  String            @id @default(uuid()) @db.Char(36)
  userId              String            @unique @db.Char(36)
  weeklyBudget        Int?
  dailyCalorieTarget  Int?
  dietaryStyle        DietaryStyle?
  preferSimpleRecipes Boolean           @default(true)
  maxCookTimeMinutes  Int?
  skillLevel          SkillLevel        @default(beginner)
  householdSize       Int               @default(1) @db.TinyInt
  aiPersonalityMode   AiPersonalityMode @default(friendly)
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  activityLevel       String?           @db.VarChar(20)
  cookingFrequency    String?           @db.VarChar(30)
  height              Int?              @db.SmallInt
  primaryGoal         String?           @db.VarChar(50)
  weight              Int?              @db.SmallInt
  expiryAlert         Boolean           @default(true)
  pushNotifications   Boolean           @default(true)
  shoppingReminder    Boolean           @default(true)
  user                User              @relation(fields: [userId], references: [id])

  @@map("user_preferences")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @db.Char(36)
  tokenHash  String    @db.VarChar(512)
  deviceInfo String?   @db.VarChar(255)
  ipAddress  String?   @db.VarChar(45)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model IngredientCategory {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique @db.VarChar(100)
  iconPath            String?              @db.VarChar(255)
  parentId            Int?
  defaultShelfLifeDays Int?                // Số ngày bảo quản mặc định (null = dùng fallback)
  createdAt           DateTime             @default(now())
  deletedAt           DateTime?
  parent              IngredientCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children            IngredientCategory[] @relation("CategoryHierarchy")
  ingredients         Ingredient[]

  @@index([parentId], map: "ingredient_categories_parentId_fkey")
  @@map("ingredient_categories")
}

model Ingredient {
  id                  Int                      @id @default(autoincrement())
  name                String                   @unique @db.VarChar(150)
  categoryId          Int
  defaultUnit         String                   @db.VarChar(30)
  caloriesPer100g     Float?
  averagePricePerUnit Int?
  imagePath           String?                  @db.VarChar(512)
  isCommon            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?
  fridgeItems         FridgeItem[]
  purchaseLinks       IngredientPurchaseLink[]
  category            IngredientCategory       @relation(fields: [categoryId], references: [id])
  recipeIngredients   RecipeIngredient[]
  shoppingItems       ShoppingListItem[]
  allergies           UserAllergy[]

  @@index([categoryId], map: "ingredients_categoryId_fkey")
  @@map("ingredients")
}

model Tag {
  id         Int         @id @default(autoincrement())
  name       String      @unique @db.VarChar(80)
  type       TagType
  createdAt  DateTime    @default(now())
  deletedAt  DateTime?
  recipeTags RecipeTag[]

  @@map("tags")
}

model Recipe {
  id              String             @id @default(uuid()) @db.Char(36)
  title           String             @db.VarChar(255)
  description     String?            @db.Text
  thumbnailPath   String?            @db.VarChar(512)
  mealType        MealType
  cookTimeMinutes Int
  servings        Int                @db.TinyInt
  difficultyLevel DifficultyLevel
  estimatedCost   Int?
  isAiGenerated   Boolean            @default(false)
  authorId        String?            @db.Char(36)
  status          RecipeStatus       @default(published)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  campaigns       CampaignRecipe[]
  mealSlots       MealSlot[]
  ingredients     RecipeIngredient[]
  steps           RecipeStep[]
  tags            RecipeTag[]
  author          User?              @relation(fields: [authorId], references: [id])
  savedBy         UserSavedRecipe[]

  @@index([authorId], map: "recipes_authorId_fkey")
  @@fulltext([title, description])
  @@map("recipes")
}

model RecipeIngredient {
  id           Int        @id @default(autoincrement())
  recipeId     String     @db.Char(36)
  ingredientId Int
  quantity     Float
  unit         String     @db.VarChar(30)
  isOptional   Boolean    @default(false)
  note         String?    @db.VarChar(255)
  deletedAt    DateTime?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  recipe       Recipe     @relation(fields: [recipeId], references: [id])

  @@index([ingredientId], map: "recipe_ingredients_ingredientId_fkey")
  @@index([recipeId], map: "recipe_ingredients_recipeId_fkey")
  @@map("recipe_ingredients")
}

model RecipeStep {
  id              Int       @id @default(autoincrement())
  recipeId        String    @db.Char(36)
  stepNumber      Int       @db.TinyInt
  instruction     String    @db.Text
  imagePath       String?   @db.VarChar(512)
  durationMinutes Int?
  deletedAt       DateTime?
  recipe          Recipe    @relation(fields: [recipeId], references: [id])

  @@index([recipeId], map: "recipe_steps_recipeId_fkey")
  @@map("recipe_steps")
}

model RecipeTag {
  recipeId String @db.Char(36)
  tagId    Int
  recipe   Recipe @relation(fields: [recipeId], references: [id])
  tag      Tag    @relation(fields: [tagId], references: [id])

  @@id([recipeId, tagId])
  @@index([tagId], map: "recipe_tags_tagId_fkey")
  @@map("recipe_tags")
}

model UserSavedRecipe {
  userId    String    @db.Char(36)
  recipeId  String    @db.Char(36)
  savedAt   DateTime  @default(now())
  deletedAt DateTime?
  recipe    Recipe    @relation(fields: [recipeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([userId, recipeId])
  @@index([recipeId], map: "user_saved_recipes_recipeId_fkey")
  @@map("user_saved_recipes")
}

model FridgeItem {
  id              String          @id @default(uuid()) @db.Char(36)
  userId          String          @db.Char(36)
  ingredientId    Int
  quantity        Float
  unit            String          @db.VarChar(30)
  purchasedAt     DateTime?
  expiresAt       DateTime?
  storageLocation StorageLocation @default(fridge)
  addedBy         AddedBy         @default(manual)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  consumedAt      DateTime?
  ingredient      Ingredient      @relation(fields: [ingredientId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([ingredientId], map: "fridge_items_ingredientId_fkey")
  @@map("fridge_items")
}

model IngredientScanLog {
  id               String           @id @default(uuid()) @db.Char(36)
  userId           String           @db.Char(36)
  imagePath        String           @db.VarChar(512)
  aiRawResponse    Json
  detectedItems    Json
  confirmedItems   Json?
  processingStatus ProcessingStatus @default(pending)
  errorMessage     String?          @db.Text
  processedAt      DateTime?
  createdAt        DateTime         @default(now())
  deletedAt        DateTime?
  barcode          String?          @db.VarChar(50)
  rawText          String?          @db.Text
  scanType         String           @default("image") @db.VarChar(20)
  user             User             @relation(fields: [userId], references: [id])

  @@index([userId], map: "ingredient_scan_logs_userId_fkey")
  @@map("ingredient_scan_logs")
}

model UserAllergy {
  id            Int             @id @default(autoincrement())
  userId        String          @db.Char(36)
  ingredientId  Int
  severityLevel AllergySeverity
  note          String?         @db.VarChar(255)
  createdAt     DateTime        @default(now())
  deletedAt     DateTime?
  ingredient    Ingredient      @relation(fields: [ingredientId], references: [id])
  user          User            @relation(fields: [userId], references: [id])

  @@unique([userId, ingredientId])
  @@index([ingredientId], map: "user_allergies_ingredientId_fkey")
  @@map("user_allergies")
}

model WeeklyPlan {
  id             String            @id @default(uuid()) @db.Char(36)
  userId         String            @db.Char(36)
  weekStartDate  DateTime          @db.Date
  totalBudget    Int
  actualCost     Int?
  status         WeeklyPlanStatus  @default(draft)
  generatedByAi  Boolean           @default(true)
  aiSessionId    String?           @db.Char(36)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  evaluationLogs AiEvaluationLog[]
  dailyPlans     DailyPlan[]
  shoppingLists  ShoppingList[]
  aiSession      ChatSession?      @relation(fields: [aiSessionId], references: [id])
  user           User              @relation(fields: [userId], references: [id])

  @@index([userId, weekStartDate])
  @@index([aiSessionId], map: "weekly_plans_aiSessionId_fkey")
  @@map("weekly_plans")
}

model DailyPlan {
  id           String     @id @default(uuid()) @db.Char(36)
  weeklyPlanId String     @db.Char(36)
  dayOfWeek    Int        @db.TinyInt
  date         DateTime   @db.Date
  dailyBudget  Int?
  deletedAt    DateTime?
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id])
  mealSlots    MealSlot[]

  @@index([weeklyPlanId], map: "daily_plans_weeklyPlanId_fkey")
  @@map("daily_plans")
}

model MealSlot {
  id            String    @id @default(uuid()) @db.Char(36)
  dailyPlanId   String    @db.Char(36)
  mealType      MealType
  recipeId      String?   @db.Char(36)
  servings      Int       @default(1) @db.TinyInt
  estimatedCost Int?
  note          String?   @db.VarChar(255)
  completedAt   DateTime?
  deletedAt     DateTime?
  dailyPlan     DailyPlan @relation(fields: [dailyPlanId], references: [id])
  recipe        Recipe?   @relation(fields: [recipeId], references: [id])

  @@index([dailyPlanId], map: "meal_slots_dailyPlanId_fkey")
  @@index([recipeId], map: "meal_slots_recipeId_fkey")
  @@map("meal_slots")
}

model ShoppingList {
  id                 String             @id @default(uuid()) @db.Char(36)
  userId             String             @db.Char(36)
  weeklyPlanId       String?            @db.Char(36)
  title              String             @db.VarChar(150)
  status             ShoppingListStatus @default(draft)
  totalEstimatedCost Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  items              ShoppingListItem[]
  user               User               @relation(fields: [userId], references: [id])
  weeklyPlan         WeeklyPlan?        @relation(fields: [weeklyPlanId], references: [id])

  @@index([userId], map: "shopping_lists_userId_fkey")
  @@index([weeklyPlanId], map: "shopping_lists_weeklyPlanId_fkey")
  @@map("shopping_lists")
}

model ShoppingListItem {
  id             Int          @id @default(autoincrement())
  shoppingListId String       @db.Char(36)
  ingredientId   Int
  quantity       Float
  unit           String       @db.VarChar(30)
  estimatedPrice Int?
  isPurchased    Boolean      @default(false)
  purchasedAt    DateTime?
  deletedAt      DateTime?
  ingredient     Ingredient   @relation(fields: [ingredientId], references: [id])
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id])

  @@index([ingredientId], map: "shopping_list_items_ingredientId_fkey")
  @@index([shoppingListId], map: "shopping_list_items_shoppingListId_fkey")
  @@map("shopping_list_items")
}

model AiSystemPrompt {
  id              Int       @id @default(autoincrement())
  agentType       AgentType
  version         String    @db.VarChar(20)
  promptContent   String    @db.LongText
  isActive        Boolean   @default(false)
  activatedAt     DateTime?
  activatedBy     String?   @db.Char(36)
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  activatedByUser User?     @relation("PromptActivatedBy", fields: [activatedBy], references: [id])

  @@unique([agentType, version])
  @@index([activatedBy], map: "ai_system_prompts_activatedBy_fkey")
  @@map("ai_system_prompts")
}

model ChatSession {
  id              String            @id @default(uuid()) @db.Char(36)
  userId          String            @db.Char(36)
  title           String?           @db.VarChar(255)
  intent          ChatIntent?
  status          ChatSessionStatus @default(active)
  totalTokensUsed Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  closedAt        DateTime?
  deletedAt       DateTime?
  evaluationLogs  AiEvaluationLog[]
  messages        ChatMessage[]
  user            User              @relation(fields: [userId], references: [id])
  weeklyPlans     WeeklyPlan[]

  @@index([userId], map: "chat_sessions_userId_fkey")
  @@map("chat_sessions")
}

model ChatMessage {
  id             String      @id @default(uuid()) @db.Char(36)
  sessionId      String      @db.Char(36)
  role           MessageRole
  content        String      @db.LongText
  contentType    ContentType @default(text)
  attachmentPath String?     @db.VarChar(512)
  agentType      AgentType?
  tokensUsed     Int?
  latencyMs      Int?
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?
  session        ChatSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model AiEvaluationLog {
  id               String           @id @default(uuid()) @db.Char(36)
  sessionId        String           @db.Char(36)
  weeklyPlanId     String?          @db.Char(36)
  attemptNumber    Int              @db.TinyInt
  evaluationResult EvaluationResult
  failureReasons   Json?
  budgetAllocated  Int
  budgetCalculated Int?
  createdAt        DateTime         @default(now())
  deletedAt        DateTime?
  session          ChatSession      @relation(fields: [sessionId], references: [id])
  weeklyPlan       WeeklyPlan?      @relation(fields: [weeklyPlanId], references: [id])

  @@index([sessionId], map: "ai_evaluation_logs_sessionId_fkey")
  @@index([weeklyPlanId], map: "ai_evaluation_logs_weeklyPlanId_fkey")
  @@map("ai_evaluation_logs")
}

model AiProviderConfig {
  id              Int        @id @default(autoincrement())
  provider        AiProvider
  modelName       String     @db.VarChar(100)
  encryptedApiKey String     @db.Text
  isActive        Boolean    @default(false)
  temperature     Float      @default(0.7)
  maxTokens       Int        @default(8192)
  usageNote       String?    @db.VarChar(255)
  activatedBy     String?    @db.Char(36)
  activatedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  activatedByUser User?      @relation("ConfigActivatedBy", fields: [activatedBy], references: [id])

  @@unique([provider, modelName])
  @@index([isActive, provider])
  @@index([activatedBy], map: "ai_provider_configs_activatedBy_fkey")
  @@map("ai_provider_configs")
}

model AiUsageLog {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @db.Char(36)
  featureType String   @db.VarChar(50)
  tokensUsed  Int?     @default(0)
  usedAt      DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, featureType, usedAt])
  @@map("ai_usage_logs")
}

model Sponsor {
  id            Int                      @id @default(autoincrement())
  name          String                   @db.VarChar(150)
  logoPath      String?                  @db.VarChar(512)
  websiteUrl    String?                  @db.VarChar(512)
  contactEmail  String?                  @db.VarChar(255)
  status        SponsorStatus
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  deletedAt     DateTime?
  purchaseLinks IngredientPurchaseLink[]
  campaigns     SponsorCampaign[]

  @@map("sponsors")
}

model SponsorCampaign {
  id             String           @id @default(uuid()) @db.Char(36)
  sponsorId      Int
  title          String           @db.VarChar(255)
  description    String?          @db.Text
  campaignType   CampaignType
  targetAudience Json?
  startDate      DateTime         @db.Date
  endDate        DateTime?        @db.Date
  status         CampaignStatus
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  recipes        CampaignRecipe[]
  sponsor        Sponsor          @relation(fields: [sponsorId], references: [id])

  @@index([sponsorId], map: "sponsor_campaigns_sponsorId_fkey")
  @@map("sponsor_campaigns")
}

model CampaignRecipe {
  campaignId String          @db.Char(36)
  recipeId   String          @db.Char(36)
  priority   Int             @default(0) @db.TinyInt
  campaign   SponsorCampaign @relation(fields: [campaignId], references: [id])
  recipe     Recipe          @relation(fields: [recipeId], references: [id])

  @@id([campaignId, recipeId])
  @@index([recipeId], map: "campaign_recipes_recipeId_fkey")
  @@map("campaign_recipes")
}

model IngredientPurchaseLink {
  id              Int               @id @default(autoincrement())
  ingredientId    Int
  sponsorId       Int?
  platform        EcommercePlatform
  productName     String            @db.VarChar(255)
  purchaseUrl     String            @db.VarChar(1024)
  priceVnd        Int?
  unitDescription String?           @db.VarChar(100)
  thumbnailPath   String?           @db.VarChar(512)
  isActive        Boolean           @default(true)
  priority        Int               @default(0) @db.TinyInt
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  ingredient      Ingredient        @relation(fields: [ingredientId], references: [id])
  sponsor         Sponsor?          @relation(fields: [sponsorId], references: [id])

  @@index([ingredientId, isActive, priority])
  @@index([sponsorId], map: "ingredient_purchase_links_sponsorId_fkey")
  @@map("ingredient_purchase_links")
}

model AdminActivityLog {
  id           String   @id @default(uuid()) @db.Char(36)
  adminId      String   @db.Char(36)
  action       String   @db.VarChar(100)
  targetEntity String?  @db.VarChar(100)
  targetId     String?  @db.VarChar(36)
  oldValue     Json?
  newValue     Json?
  ipAddress    String?  @db.VarChar(45)
  createdAt    DateTime @default(now())
  admin        User     @relation(fields: [adminId], references: [id])

  @@index([adminId], map: "admin_activity_logs_adminId_fkey")
  @@map("admin_activity_logs")
}

model Notification {
  id        String           @id @default(uuid()) @db.Char(36)
  userId    String           @db.Char(36)
  type      NotificationType
  title     String           @db.VarChar(255)
  body      String           @db.Text
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?
  deletedAt DateTime?
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model UserDevice {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @db.Char(36)
  fcmToken   String   @unique @db.VarChar(512)
  platform   String   @db.VarChar(20)  // "android" | "ios" | "web"
  deviceName String?  @db.VarChar(100)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_devices")
}

model CronJobConfig {
  id             Int       @id @default(autoincrement())
  name           String    @unique @db.VarChar(100)
  cronExpression String    @db.VarChar(50)
  isEnabled      Boolean   @default(true)
  description    String    @db.VarChar(255)
  lastRunAt      DateTime?
  lastRunStatus  String?   @db.VarChar(20) // success | failed
  updatedAt      DateTime  @updatedAt

  @@map("cron_job_configs")
}

model SubscriptionPlan {
  id             Int                @id @default(autoincrement())
  name           String             @unique @db.VarChar(50)
  displayName    String             @db.VarChar(100)
  priceVnd       Int                @default(0)
  billingCycle   String             @db.VarChar(20)
  features       Json
  aiUsagePerWeek Int                @default(2) @db.TinyInt
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  deletedAt      DateTime?
  subscriptions       UserSubscription[]
  paymentTransactions PaymentTransaction[]

  @@map("subscription_plans")
}

model UserSubscription {
  id             String           @id @default(uuid()) @db.Char(36)
  userId         String           @unique @db.Char(36)
  planId         Int
  startDate      DateTime         @db.Date
  endDate        DateTime?        @db.Date
  status         String           @db.VarChar(20)  // active | pending | cancelled
  pendingPlanId  Int?                               // planId đang chờ thanh toán (chưa activate)
  autoRenew      Boolean          @default(true)   // false = đặt hủy gia hạn cuối kỳ
  cancelledAt    DateTime?                          // thời điểm user yêu cầu hủy gia hạn
  quotaResetAt   DateTime?                          // reset quota AI khi mua gói mới
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([planId], map: "user_subscriptions_planId_fkey")
  @@map("user_subscriptions")
}

model PaymentTransaction {
  id                  String   @id @default(uuid()) @db.Char(36)
  userId              String   @db.Char(36)
  planId              Int
  type                String   @db.VarChar(20)    // 'subscribe' | 'renew'
  amount              Int                          // số tiền VND
  status              String   @db.VarChar(20)    // pending | paid | failed | cancelled | expired
  paymentMethod       String   @default("payos") @db.VarChar(30)
  paymentRef          String?  @unique @db.VarChar(100) // mã nội bộ FRIGGY-xxx
  payosOrderCode      BigInt?  @unique                  // orderCode PayOS (số nguyên)
  payosPaymentLinkId  String?  @db.VarChar(100)
  payosTransactionRef String?  @db.VarChar(100)    // reference từ webhook PayOS
  description         String?  @db.VarChar(100)    // nội dung CK
  checkoutUrl         String?  @db.VarChar(500)    // link thanh toán
  qrCode              String?  @db.Text             // QR code từ PayOS (base64 hoặc URL)
  expiredAt           DateTime?                     // thời điểm link hết hạn
  paidAt              DateTime?                     // thời điểm thanh toán thành công
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  plan                SubscriptionPlan @relation(fields: [planId], references: [id])
  user                User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([payosOrderCode])
  @@index([status, expiredAt])
  @@map("payment_transactions")
}

