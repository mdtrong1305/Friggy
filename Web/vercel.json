{
  "headers": [
    {
      "source": "/friggy-app.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"friggy-app.apk\"" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!friggy-app\\.apk$).*)",
      "destination": "/index.html"
    }
  ]
}
